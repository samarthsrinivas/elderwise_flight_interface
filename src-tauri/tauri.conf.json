{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "elderwise",
  "version": "0.2.2",
  "identifier": "com.elderwise.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Elderwise",
        "width": 1100,
        "height": 750
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../ml/age_service.py",
      "../ml/embed.py",
      "../ml/wavlm_mlx.py",
      "../ml/requirements.txt",
      "../ml/README.md"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "Developer ID Application: AJENTIK AI PTE. LTD. (6SJY3B6C35)",
      "hardenedRuntime": true,
      "minimumSystemVersion": "10.15"
    }
  }
}
